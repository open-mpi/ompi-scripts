+++ m4-1.4.17/lib/c-stack.c	2026-10-19 22:06:35.407298608 +0000
@@ -52,13 +52,17 @@
 #endif
 #ifndef SIGSTKSZ
 # define SIGSTKSZ 16384
-#elif HAVE_LIBSIGSEGV && SIGSTKSZ < 16384
+#elif defined(HAVE_LIBSIGSEGV)
+/* Modern platforms define SIGSTKSZ as a sysconf(), so need to embed checks a
+ * bit. */
+#if SIGSTKSZ < 16384
 /* libsigsegv 2.6 through 2.8 have a bug where some architectures use
    more than the Linux default of an 8k alternate stack when deciding
    if a fault was caused by stack overflow.  */
 # undef SIGSTKSZ
 # define SIGSTKSZ 16384
 #endif
+#endif
 
